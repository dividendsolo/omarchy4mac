#!/usr/bin/env bash
# JankyBorders — Tokyo Night
# Reload: brew services restart borders
# Docs: https://github.com/FelixKratz/JankyBorders

options=(
  style=round                # round | square
  width=5.0
  hidpi=on
  active_color=0xff7aa2f7    # Tokyo Night blue
  inactive_color=0xff414868  # Tokyo Night overlay (subtle)
  background_color=0x00000000
  # Ignore invisible system alert windows (ghost borders on empty workspaces)
  blacklist="UserNotificationCenter"
)

borders "${options[@]}"
