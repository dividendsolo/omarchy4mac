#!/bin/bash

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

THEME="$HOME/.local/bin/theme"
STATE="$HOME/.config/theme-switcher/current"

log() { echo "$(date '+%H:%M:%S') $*"; }

[[ -s "$STATE" ]] || exit 0

want="$("$THEME" --mode)"
have="$("$THEME" --appearance 2>/dev/null)" || exit 0
[[ "$want" == "$have" ]] && exit 0

sleep 1
settled="$("$THEME" --mode)"
if [[ "$settled" != "$want" ]]; then
  log "appearance unsettled ($want -> $settled), re-reading"
  want="$settled"
fi
[[ "$want" == "$have" ]] && exit 0

LOCK="$HOME/.config/theme-switcher/lock"
for _ in 1 2 3; do
  for _ in $(seq 60); do [[ -d "$LOCK" ]] || break; sleep 0.5; done
  want="$("$THEME" --mode)"
  have="$("$THEME" --appearance 2>/dev/null)" || exit 0
  [[ "$want" == "$have" ]] && exit 0
  log "appearance is $want but theme $(cat "$STATE") is $have — switching"
  "$THEME" random "$want"
done
