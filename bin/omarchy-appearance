#!/usr/bin/env bash
#
# omarchy-appearance — Omarchy 4.5's Trigger > Appearance on the Mac.
#
#   omarchy-appearance transparency [opaque|transparent|glassy]
#   omarchy-appearance corners      [theme|sharp|rounded]
#
# With no value it prints the current choice (the menu's check mark reads it).
# The choice is saved in ~/.config/omarchy/, so it outlives a restart:
# sketchybarrc and bordersrc read it whenever they start.
#
# Transparency reaches the terminal (Ghostty background-opacity and blur) and
# the bar (SketchyBar background alpha). Other apps stay opaque: macOS draws
# them solid, the way Omarchy 4.5 makes apps opaque and leaves terminals
# see-through. Corners set the JankyBorders style; macOS rounds the windows
# themselves and no app can change that. "theme" keeps the default round
# border: Omarchy's themes ship no corners of their own for the Mac to read.
set -euo pipefail

DIR="$HOME/.config/omarchy"
GHOSTTY_MAC="$HOME/Library/Application Support/com.mitchellh.ghostty"
GHOSTTY_XDG="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"

usage() { sed -n '5,6p' "$0" | sed 's/^# \{0,1\}/usage: /' >&2; exit 1; }

# set_key <file> <key> <value>: one `key = value` line, every old one replaced.
set_key() {
  if grep -qE "^[[:space:]]*$2[[:space:]]*=" "$1"; then
    K="$2" V="$3" perl -0pi -e 's/^[ \t]*\Q$ENV{K}\E[ \t]*=.*$/$ENV{K} = $ENV{V}/mg' "$1"
  else
    printf '%s = %s\n' "$2" "$3" >> "$1"
  fi
}

ghostty() { # ghostty <opacity> <blur>: every config Ghostty reads (bin/theme does the same)
  local cfg found=0
  for cfg in "$GHOSTTY_MAC/config" "$GHOSTTY_XDG/config"; do
    [[ -f "$cfg" ]] || continue
    found=1; set_key "$cfg" background-opacity "$1"; set_key "$cfg" background-blur "$2"
  done
  if [[ "$found" -eq 0 ]]; then
    mkdir -p "$GHOSTTY_MAC"; : > "$GHOSTTY_MAC/config"
    set_key "$GHOSTTY_MAC/config" background-opacity "$1"; set_key "$GHOSTTY_MAC/config" background-blur "$2"
  fi
}

sketchybar_bin() { command -v sketchybar 2>/dev/null || echo /opt/homebrew/bin/sketchybar; }
brew_bin() { command -v brew 2>/dev/null || echo /opt/homebrew/bin/brew; }

[[ $# -ge 1 ]] || usage
what="$1"; value="${2:-}"
case "$what" in
  transparency) default=transparent; choices=" opaque transparent glassy " ;;
  corners)      default=theme;       choices=" theme sharp rounded " ;;
  *) usage ;;
esac
state="$DIR/window-$what"

if [[ -z "$value" ]]; then
  cur="$(cat "$state" 2>/dev/null || true)"
  [[ "$choices" == *" $cur "* ]] && echo "$cur" || echo "$default"
  exit 0
fi
[[ "$choices" == *" $value "* ]] || usage

mkdir -p "$DIR"; echo "$value" > "$state"
case "$what:$value" in
  transparency:opaque)      ghostty 1 false ;;
  transparency:transparent) ghostty 0.75 false ;;
  transparency:glassy)      ghostty 0.65 20 ;;
esac
if [[ "$what" == transparency ]]; then
  "$(sketchybar_bin)" --reload >/dev/null 2>&1 || true
  # Ghostty applies background-opacity on macOS only after a full restart.
  echo "Window transparency: $value. Quit and reopen Ghostty to see it."
else
  "$(brew_bin)" services restart borders >/dev/null 2>&1 || true
  echo "Window corners: $value."
fi
