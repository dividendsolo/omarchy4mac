#!/usr/bin/env bash
#
# theme — unified theme switcher for Ghostty + Neovim (LazyVim),
#         driven by Omarchy's own theme definitions.
#
# Usage:
#   theme                 show current theme + list installed
#   theme <name>          switch to <name>
#   theme random          switch to a random theme matching the current
#                         macOS appearance (light system → light themes only,
#                         dark system → dark themes only); never repicks current
#   theme -l | --list     list installed themes
#   theme --mode          print current macOS appearance: light | dark
#   theme --appearance    print the light/dark appearance of the current theme
#                         (or of [name], if given)
#   theme -s | --sync     download / refresh all themes from the Omarchy repo
#   theme --no-reload <n> switch without trying to live-reload Ghostty
#
# `--sync` pulls every theme from github.com/omacom/omarchy (quattro), renders
# Ghostty, btop, and neovim from Omarchy's own templates, and fetches each
# theme's backgrounds into ~/Pictures/Wallpapers. Switching is then offline.

set -euo pipefail

# Omarchy 4 (Quattro): the repo moved to omacom/omarchy, default branch
# quattro. A theme ships colors.toml (24 named colours, plus mode), an
# optional neovim.lua, and backgrounds/. btop, ghostty, and a fallback
# neovim spec are rendered from default/themed/*.tpl, the same templates
# Omarchy renders at theme-set time.
REPO="omacom/omarchy"
REF="${OMARCHY_REF:-quattro}"         # set OMARCHY_REF=master for the 3.x layout (unsupported)
RAW="https://raw.githubusercontent.com/$REPO/$REF"
API="https://api.github.com/repos/$REPO/contents"
TEMPLATES=(btop.theme.tpl ghostty.conf.tpl neovim.lua.tpl claude.json.tpl obsidian.css.tpl)

CACHE="$HOME/.config/theme-switcher/cache"      # cache/<name>/{colors.toml,neovim.lua,btop.theme,claude.json,obsidian.css}
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
OBSIDIAN_JSON="$HOME/Library/Application Support/obsidian/obsidian.json"
TPL_CACHE="$HOME/.config/theme-switcher/templates"
WALLPAPERS="$HOME/Pictures/Wallpapers"
STATE="$HOME/.config/theme-switcher/current"
NVIM_THEME_FILE="$HOME/.config/nvim/lua/plugins/theme.lua"
BTOP_THEMES_DIR="$HOME/.config/btop/themes"
BTOP_CONFIG="$HOME/.config/btop/btop.conf"
SKETCHYBAR_COLORS="$HOME/.config/sketchybar/colors.sh"

# Ghostty reads BOTH the macOS app-support config and the XDG config, with the
# app-support one loaded last (it wins). Edit whichever actually takes effect.
GHOSTTY_MAC="$HOME/Library/Application Support/com.mitchellh.ghostty"
GHOSTTY_XDG="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"

# every ghostty config Ghostty might read. We keep the `theme =` line in sync in
# ALL of them so it doesn't matter which one wins precedence — they all agree.
# (Ghostty loads both the macOS app-support config and the XDG config; which one
# wins has bitten us before, so we stop betting on it.)
ghostty_configs() {
  local found=0
  [[ -f "$GHOSTTY_MAC/config" ]] && { echo "$GHOSTTY_MAC/config"; found=1; }
  [[ -f "$GHOSTTY_XDG/config" ]] && { echo "$GHOSTTY_XDG/config"; found=1; }
  # nothing exists yet → default to the macOS app-support path
  [[ "$found" -eq 1 ]] || echo "$GHOSTTY_MAC/config"
}
# all themes/ dirs Ghostty might search — write generated theme files to each
ghostty_theme_dirs() {
  [[ -d "$GHOSTTY_MAC" ]] && echo "$GHOSTTY_MAC/themes"
  echo "$GHOSTTY_XDG/themes"
}

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_grn=$'\033[32m'; c_red=$'\033[31m'; c_yel=$'\033[33m'; c_rst=$'\033[0m'
die() { echo "${c_red}error:${c_rst} $*" >&2; exit 1; }

# Render an Omarchy template ({{ key }}, {{ key_strip }}, {{ key_rgb }},
# {{ mix a b amount }}) against a colors.toml. Mirrors
# bin/omarchy-theme-set-templates: selection_background = selection,
# selection_foreground = bright_foreground, legacy bg/fg names, and
# color0..15 from the named palette. orange and brown are optional upstream
# (Solitude, Last Horizon, White omit them) and fall back to yellow / muted.
render_template() {
  local colors="$1" tpl="$2"
  COLORS="$colors" TPL="$tpl" python3 - <<'PY'
import os, re
c = {}
for line in open(os.environ["COLORS"]):
    m = re.match(r'\s*([A-Za-z0-9_]+)\s*=\s*"([^"]*)"', line)
    if m: c[m.group(1)] = m.group(2)
legacy = {"bg": "background", "dark_bg": "dark_background", "darker_bg": "darker_background",
          "lighter_bg": "lighter_background", "fg": "foreground", "dark_fg": "dark_foreground",
          "light_fg": "light_foreground", "bright_fg": "bright_foreground"}
for short, canon in legacy.items():
    if canon in c: c[short] = c[canon]
    elif short in c: c[canon] = c[short]
c.setdefault("mode", c.get("theme_type", "dark"))
c["theme_type"] = c["mode"]
c.setdefault("selection_background", c.get("selection", c.get("background", "#000000")))
c.setdefault("selection_foreground", c.get("bright_foreground", c.get("foreground", "#ffffff")))
c.setdefault("accent", c.get("blue", c.get("color4", c.get("foreground", "#ffffff"))))
c.setdefault("muted", c.get("color8", c.get("dark_foreground", c.get("foreground", "#888888"))))
c.setdefault("orange", c.get("bright_yellow", c.get("yellow", c.get("color3", "#ffaa00"))))
c.setdefault("brown", c.get("muted"))
ansi = ["background", "red", "green", "yellow", "blue", "magenta", "cyan", "foreground",
        "muted", "bright_red", "bright_green", "bright_yellow", "bright_blue", "bright_magenta",
        "bright_cyan", "bright_foreground"]
for i, name in enumerate(ansi):
    c.setdefault(f"color{i}", c.get(name, c.get("foreground", "#ffffff")))
for name in list(c):
    if name.startswith("bright_") and name not in c: pass
def rgb(h):
    h = h.lstrip("#"); return f"{int(h[0:2],16)},{int(h[2:4],16)},{int(h[4:6],16)}"
def mix(a, b, amt):
    amt = amt.strip()
    f = float(amt[:-1]) / 100 if amt.endswith("%") else float(amt)
    if f > 1: f /= 100
    a, b = a.lstrip("#"), b.lstrip("#")
    out = [round(int(a[i:i+2],16) * (1 - f) + int(b[i:i+2],16) * f) for i in (0, 2, 4)]
    return "#%02x%02x%02x" % tuple(out)
def sub(m):
    parts = m.group(1).split()
    if parts[0] in ("mix", "mix_strip", "mix_rgb") and len(parts) == 4:
        v = mix(c.get(parts[1], "#000000"), c.get(parts[2], "#000000"), parts[3])
        return v.lstrip("#") if parts[0] == "mix_strip" else rgb(v) if parts[0] == "mix_rgb" else v
    key = parts[0]
    if key.endswith("_strip"): return c.get(key[:-6], "").lstrip("#")
    if key.endswith("_rgb") and key[:-4] in c: return rgb(c[key[:-4]])
    return c.get(key, "")
print(re.sub(r"\{\{\s*(.*?)\s*\}\}", sub, open(os.environ["TPL"]).read()), end="")
PY
}

# colors.toml (stdin) -> SketchyBar colors.sh (stdout). v4 palette keys.
toml_to_sketchybar() {
  awk '
    function strip(s){ sub(/^[^=]*=/,"",s); gsub(/[" \t\r]/,"",s); return s }
    function argb(hex,a){ sub(/^#/,"",hex); return "0x" a tolower(hex) }
    function pick(a,b,c){ return colors[a] ? colors[a] : (colors[b] ? colors[b] : colors[c]) }
    { key=$0; sub(/[ \t]*=.*/,"",key); gsub(/[ \t\r]/,"",key); val=strip($0); colors[key]=val }
    END {
      print "#!/usr/bin/env bash"
      print "# Generated by `theme` from Omarchy colors.toml. Do not edit by hand."
      print "export BG=\""        argb(colors["background"],                 "ff") "\""
      print "export BG_TRANS=\""  argb(colors["background"],                 "c0") "\""
      print "export FG=\""        argb(colors["foreground"],                 "ff") "\""
      print "export SURFACE=\""   argb(pick("selection","selection_background","color8"), "ff") "\""
      print "export OVERLAY=\""   argb(pick("muted","color8","foreground"),  "ff") "\""
      print "export COMMENT=\""   argb(pick("muted","color8","foreground"),  "ff") "\""
      print "export ACCENT=\""    argb(pick("accent","blue","color4"),       "ff") "\""
      print "export RED=\""       argb(pick("red","color1","foreground"),    "ff") "\""
      print "export GREEN=\""     argb(pick("green","color2","foreground"),  "ff") "\""
      print "export YELLOW=\""    argb(pick("yellow","color3","foreground"), "ff") "\""
      print "export BLUE=\""      argb(pick("blue","color4","foreground"),   "ff") "\""
      print "export MAGENTA=\""   argb(pick("magenta","color5","foreground"),"ff") "\""
      print "export CYAN=\""      argb(pick("cyan","color6","foreground"),   "ff") "\""
      print "export ORANGE=\""    argb(pick("orange","bright_yellow","yellow"), "ff") "\""
    }'
}

# extract `colorscheme = "X"` from a neovim.lua spec
colorscheme_of() {
  grep -oE 'colorscheme[[:space:]]*=[[:space:]]*"[^"]+"' "$1" 2>/dev/null \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/'
}

installed_themes() {
  [[ -d "$CACHE" ]] || return 0
  find "$CACHE" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort
}

current_theme() { [[ -f "$STATE" ]] && cat "$STATE" || echo "(none)"; }

system_appearance() {
  # Ask the live session via System Events — `defaults read` can serve a stale
  # cfprefsd view in some process contexts (observed lying in a shell session).
  local dm
  dm="$(osascript -e 'tell application "System Events" to tell appearance preferences to get dark mode' 2>/dev/null)"
  case "$dm" in
    true)  echo dark ;;
    false) echo light ;;
    *)     [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == *Dark* ]] && echo dark || echo light ;;
  esac
}

# light/dark from the theme's `mode` key (v4), else background luminance
theme_appearance() {
  local bg mode
  mode="$(awk -F= '$1 ~ /^[[:space:]]*mode[[:space:]]*$/ {gsub(/[" \t\r]/,"",$2); print $2; exit}' "$CACHE/$1/colors.toml" 2>/dev/null)"
  case "$mode" in light|dark) echo "$mode"; return ;; esac
  bg="$(awk -F= '$1 ~ /^[[:space:]]*background[[:space:]]*$/ {gsub(/[" \t\r#]/,"",$2); print $2; exit}' "$CACHE/$1/colors.toml" 2>/dev/null)"
  [[ "$bg" =~ ^[0-9a-fA-F]{6}$ ]] || { echo dark; return; }
  local r=$((16#${bg:0:2})) g=$((16#${bg:2:2})) b=$((16#${bg:4:2}))
  local lum=$(( (r*299 + g*587 + b*114) / 1000 ))
  (( lum > 128 )) && echo light || echo dark
}

pick_random_theme() {
  # optional $1 forces the mode — used by theme-appearance-watch, which has
  # already detected the flip (re-detecting here races the OS transition)
  local want cur t pool=()
  want="${1:-$(system_appearance)}"
  cur="$(current_theme)"
  while IFS= read -r t; do
    [[ -n "$t" && "$t" != "$cur" && "$(theme_appearance "$t")" == "$want" ]] && pool+=("$t")
  done < <(installed_themes)
  # only match is the current theme → keep it rather than switch appearance
  if [[ ${#pool[@]} -eq 0 && "$(theme_appearance "$cur")" == "$want" ]]; then pool=("$cur"); fi
  [[ ${#pool[@]} -gt 0 ]] || die "no $want themes cached (system is in $want mode)"
  echo "${pool[$((RANDOM % ${#pool[@]}))]}"
}

sync_templates() {
  mkdir -p "$TPL_CACHE"
  local t
  for t in "${TEMPLATES[@]}"; do
    curl -fsSL --retry 3 --retry-delay 1 "$RAW/default/themed/$t" -o "$TPL_CACHE/$t" 2>/dev/null \
      || die "could not fetch template $t from $REPO@$REF"
  done
}

# Backgrounds land as <theme>_<file> so apply_wallpaper and the ⌘⌃P cycler
# find them by prefix. Existing files are kept; only missing ones download.
sync_backgrounds() {
  local n="$1" files f got=0
  files="$(curl -fsSL "$API/themes/$n/backgrounds?ref=$REF" 2>/dev/null | grep '"download_url"' | sed 's/.*"download_url": *"\([^"]*\)".*/\1/')" || return 0
  [[ -n "$files" ]] || return 0
  mkdir -p "$WALLPAPERS"
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    local base="$WALLPAPERS/${n}_$(basename "$f")"
    [[ -f "$base" ]] && continue
    curl -fsSL --retry 3 --retry-delay 1 "$f" -o "$base" 2>/dev/null && got=$((got+1))
  done <<< "$files"
  echo "$got"
}

sync_themes() {
  command -v curl >/dev/null || die "curl is required"
  echo "${c_bold}Fetching theme list from $REPO@$REF …${c_rst}"
  local names
  names="$(curl -fsSL "$API/themes?ref=$REF" 2>/dev/null | grep '"name"' | sed 's/.*"name": *"\([^"]*\)".*/\1/')" \
    || die "could not list themes (GitHub API unreachable or rate-limited)"
  [[ -n "$names" ]] || die "no themes returned from API"
  sync_templates

  mkdir -p "$CACHE"
  local d; while IFS= read -r d; do mkdir -p "$d"; done < <(ghostty_theme_dirs)
  local n got=0 skipped=0
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    local colors nvim
    colors="$(curl -fsSL --retry 3 --retry-delay 1 "$RAW/themes/$n/colors.toml" 2>/dev/null)" || colors=""
    if [[ -z "$colors" ]]; then
      printf '  %s%-18s%s %sno colors.toml — skipped%s\n' "$c_dim" "$n" "$c_rst" "$c_yel" "$c_rst"
      skipped=$((skipped+1)); continue
    fi
    mkdir -p "$CACHE/$n"
    printf '%s\n' "$colors" > "$CACHE/$n/colors.toml"

    # neovim: the theme's own spec, else Omarchy's aether template with the
    # palette baked in (what Omarchy itself does for themes without one).
    local nvim_src="theme"
    nvim="$(curl -fsSL --retry 3 --retry-delay 1 "$RAW/themes/$n/neovim.lua" 2>/dev/null)" \
      || { nvim="$(render_template "$CACHE/$n/colors.toml" "$TPL_CACHE/neovim.lua.tpl")"; nvim_src="aether"; }
    printf '%s\n' "$nvim" > "$CACHE/$n/neovim.lua"

    # btop + ghostty from the templates
    render_template "$CACHE/$n/colors.toml" "$TPL_CACHE/btop.theme.tpl" > "$CACHE/$n/btop.theme"
    render_template "$CACHE/$n/colors.toml" "$TPL_CACHE/claude.json.tpl" > "$CACHE/$n/claude.json"
    render_template "$CACHE/$n/colors.toml" "$TPL_CACHE/obsidian.css.tpl" > "$CACHE/$n/obsidian.css"
    mkdir -p "$BTOP_THEMES_DIR"
    cp "$CACHE/$n/btop.theme" "$BTOP_THEMES_DIR/omarchy-$n.theme"
    local td
    while IFS= read -r td; do
      { echo "# Omarchy theme '$n' — generated by \`theme --sync\`. Do not edit."
        render_template "$CACHE/$n/colors.toml" "$TPL_CACHE/ghostty.conf.tpl"; } > "$td/omarchy-$n"
    done < <(ghostty_theme_dirs)

    local bgs; bgs="$(sync_backgrounds "$n")"
    printf '  %s%-18s%s ghostty✓ btop✓ claude✓ obsidian✓ nvim✓(%s)%s\n' "$c_dim" "$n" "$c_rst" "$nvim_src" \
      "$([[ "${bgs:-0}" -gt 0 ]] && echo " +$bgs wallpapers" || echo "")"
    got=$((got+1))
  done <<< "$names"

  echo "${c_grn}synced $got theme(s)${c_rst}${skipped:+, skipped $skipped}."
}

list_themes() {
  local cur t any=0; cur="$(current_theme)"
  echo "${c_bold}Installed themes:${c_rst}"
  while IFS= read -r t; do
    any=1
    if [[ "$t" == "$cur" ]]; then echo "  ${c_grn}* $t${c_rst}"; else echo "    $t"; fi
  done < <(installed_themes)
  if [[ "$any" -eq 0 ]]; then echo "  ${c_dim}(none yet — run: theme --sync)${c_rst}"; fi
}

apply_ghostty() {
  local name="$1" cfg
  [[ -d "$CACHE/$name" ]] || die "theme '$name' not synced; run: theme --sync"
  while IFS= read -r cfg; do
    mkdir -p "$(dirname "$cfg")"
    if [[ -f "$cfg" ]] && grep -qE '^[[:space:]]*theme[[:space:]]*=' "$cfg"; then
      # /g so any duplicate theme lines are ALL rewritten — a stale one further
      # down the file would otherwise win and silently pin the old theme.
      GT="omarchy-$name" perl -0pi -e 's/^[ \t]*theme[ \t]*=.*$/theme = $ENV{GT}/mg' "$cfg"
    else
      printf '\ntheme = omarchy-%s\n' "$name" >> "$cfg"
    fi
    echo "  ${c_dim}ghostty${c_rst}  → omarchy-$name  ${c_dim}(${cfg/#$HOME/~})${c_rst}"
  done < <(ghostty_configs)
}

reload_ghostty() {
  # Ghostty has no reload CLI/signal. We drive its "Reload Configuration" menu
  # item via AppleScript — clicking the menu item is far more reliable than
  # synthesising the ⌘⇧, keybind (a shifted-comma keystroke frequently doesn't
  # register as the bind). Keystroke is kept as a fallback. Both need
  # Accessibility permission; if neither works we tell the user to do it by hand.
  local out
  out="$(osascript 2>&1 <<'EOF' || true
tell application "System Events"
  if not (exists process "ghostty") then return "noproc"
  tell process "ghostty"
    set frontmost to true
    delay 0.2
    -- preferred: click the actual menu item
    try
      click menu item "Reload Configuration" of menu 1 of menu bar item "Ghostty" of menu bar 1
      return "menu"
    end try
    -- fallback: fire the reload_config keybind
    keystroke "," using {command down, shift down}
    return "key"
  end tell
end tell
EOF
)"
  case "$out" in
    menu) echo "  ${c_dim}ghostty${c_rst}  ↻ reloaded (menu)" ;;
    key)  echo "  ${c_dim}ghostty${c_rst}  ↻ reloaded (keybind)" ;;
    *)
      echo "  ${c_yel}ghostty${c_rst}  use ${c_bold}Ghostty → Reload Configuration${c_rst} (or ${c_bold}⌘⇧,${c_rst}) to reload this window"
      echo "          ${c_dim}(grant Ghostty Accessibility perm to auto-reload: System Settings → Privacy & Security → Accessibility)${c_rst}"
      ;;
  esac
}

apply_nvim() {
  local name="$1" src="$CACHE/$1/neovim.lua"
  if [[ ! -f "$src" ]]; then
    echo "  ${c_yel}neovim${c_rst}   ! no neovim.lua for '$name' — editor theme unchanged"
    return 0
  fi
  mkdir -p "$(dirname "$NVIM_THEME_FILE")"
  # Aggregate plugin specs from EVERY cached theme so they're all installed and
  # eager-loaded. Each theme switch just flips the active colorscheme, never
  # waits for Lazy to install a new plugin.
  CACHE="$CACHE" CURRENT="$name" OUT="$NVIM_THEME_FILE" python3 <<'PY'
import os, re, sys
cache = os.environ['CACHE']
current = os.environ['CURRENT']
out = os.environ['OUT']

specs = []
for theme in sorted(os.listdir(cache)):
    nvim_file = os.path.join(cache, theme, 'neovim.lua')
    if not os.path.isfile(nvim_file): continue
    text = open(nvim_file).read()
    m = re.search(r'return\s*\{(.*)\}\s*\Z', text, re.DOTALL)
    if not m: continue
    inner = m.group(1)
    # Split top-level { ... } blocks
    depth = 0; start = None; blocks = []
    for i, c in enumerate(inner):
        if c == '{':
            if depth == 0: start = i
            depth += 1
        elif c == '}':
            depth -= 1
            if depth == 0 and start is not None:
                blocks.append(inner[start:i+1]); start = None
    for b in blocks:
        if 'LazyVim/LazyVim' in b: continue
        # aether.nvim is one plugin whose colours ride in opts: several
        # themes generate a spec for it (v4 template), and Lazy would merge
        # them. Keep only the current theme's copy, or the first one seen.
        if 'aether.nvim' in b:
            if theme != current and any('aether.nvim' in x for x in specs): continue
            if theme != current and os.path.exists(os.path.join(cache, current, 'neovim.lua')) \
               and 'aether.nvim' in open(os.path.join(cache, current, 'neovim.lua')).read(): continue
            specs[:] = [x for x in specs if 'aether.nvim' not in x]
        # Inject `lazy = false` right after the plugin name string
        b2 = re.sub(r'(\{\s*"[^"]+")', r'\1, lazy = false', b, count=1)
        # Strip any auto-applied colorscheme inside the spec's config() — those
        # would override whatever LazyVim's colorscheme option resolves to.
        # Matches: vim.cmd([[colorscheme foo]]) / vim.cmd("colorscheme foo")
        #          / vim.cmd.colorscheme("foo")
        b2 = re.sub(r'\s*vim\.cmd\s*(\(\s*)?\[\[\s*colorscheme\s+[^\]]+\]\]\s*\)?', '', b2)
        b2 = re.sub(r'\s*vim\.cmd\s*\(\s*["\']\s*colorscheme\s+[^"\']+["\']\s*\)', '', b2)
        b2 = re.sub(r'\s*vim\.cmd\.colorscheme\s*\(\s*["\'][^"\']+["\']\s*\)', '', b2)
        specs.append(b2.strip())

# Find current theme's colorscheme name
cs = 'tokyonight'
src = open(os.path.join(cache, current, 'neovim.lua')).read()
m = re.search(r'colorscheme\s*=\s*"([^"]+)"', src)
if m: cs = m.group(1)

lines = [f"-- Omarchy themes — generated by `theme {current}`. Do not edit by hand.",
         "-- All theme plugins eager-loaded so switching never waits for Lazy install.",
         "return {"]
for s in specs:
    lines.append("  " + s.replace("\n", "\n  ") + ",")
lines.append("  {")
lines.append('    "LazyVim/LazyVim",')
lines.append("    opts = {")
lines.append("      colorscheme = function()")
lines.append(f'        local w = "{cs}"')
lines.append("        if not pcall(vim.cmd.colorscheme, w) then")
lines.append('          local a = (w:gsub("%-%a+$", ""))')
lines.append("          if a == w or not pcall(vim.cmd.colorscheme, a) then")
lines.append('            pcall(vim.cmd.colorscheme, "tokyonight")')
lines.append("          end")
lines.append("        end")
lines.append("      end,")
lines.append("    },")
lines.append("  },")
lines.append("}")
open(out, 'w').write("\n".join(lines) + "\n")
PY
  echo "  ${c_dim}neovim${c_rst}   → $(colorscheme_of "$src" || echo "$name") ${c_dim}(all themes eager-loaded)${c_rst}"
}

reload_nvim() {
  local cs="$1" sock count=0
  [[ -n "$cs" ]] && command -v nvim >/dev/null 2>&1 || return 0
  while IFS= read -r sock; do
    [[ -S "$sock" ]] || continue
    nvim --server "$sock" --remote-send \
      "<C-\\><C-N>:lua local w='$cs' if not pcall(vim.cmd.colorscheme,w) then pcall(vim.cmd.colorscheme,(w:gsub('%-%a+\$',''))) end<CR>" 2>/dev/null \
      && count=$((count+1)) || true
  done < <(find "${TMPDIR:-/tmp}" /tmp -maxdepth 5 -path '*nvim*' -type s \( -name '0' -o -name 'nvim.*.0' \) 2>/dev/null)
  [[ "$count" -gt 0 ]] && echo "  ${c_dim}neovim${c_rst}   ↻ reloaded $count running instance(s)"
  return 0
}

apply_btop() {
  local name="$1" src="$CACHE/$1/btop.theme"
  if [[ ! -f "$src" ]]; then
    echo "  ${c_yel}btop${c_rst}     ! no btop.theme for '$name' — skipped"
    return 0
  fi
  # Make sure the theme file is installed (sync may have run before this dir existed)
  mkdir -p "$BTOP_THEMES_DIR"
  [[ -f "$BTOP_THEMES_DIR/omarchy-$name.theme" ]] || cp "$src" "$BTOP_THEMES_DIR/omarchy-$name.theme"
  # Ensure config exists
  [[ -f "$BTOP_CONFIG" ]] || { mkdir -p "$(dirname "$BTOP_CONFIG")"; printf 'color_theme = "Default"\n' > "$BTOP_CONFIG"; }
  if grep -qE '^[[:space:]]*color_theme[[:space:]]*=' "$BTOP_CONFIG"; then
    BT="omarchy-$name" perl -0pi -e 's/^[ \t]*color_theme[ \t]*=.*$/color_theme = "$ENV{BT}"/m' "$BTOP_CONFIG"
  else
    printf '\ncolor_theme = "omarchy-%s"\n' "$name" >> "$BTOP_CONFIG"
  fi
  echo "  ${c_dim}btop${c_rst}     → omarchy-$name"
}

reload_btop() {
  # btop doesn't reload its config live; signal running instances to restart.
  # SIGUSR2 reloads config in some versions; otherwise the user must restart it.
  pkill -USR2 -x btop 2>/dev/null && echo "  ${c_dim}btop${c_rst}     ↻ signaled to reload" || true
  return 0
}

apply_sketchybar() {
  local name="$1" src="$CACHE/$1/colors.toml"
  [[ -f "$src" ]] || return 0
  [[ -d "$(dirname "$SKETCHYBAR_COLORS")" ]] || return 0
  toml_to_sketchybar < "$src" > "$SKETCHYBAR_COLORS"
  echo "  ${c_dim}sketchybar${c_rst} → palette regenerated"
}

reload_sketchybar() {
  if pgrep -x sketchybar >/dev/null 2>&1; then
    /opt/homebrew/bin/sketchybar --reload >/dev/null 2>&1 \
      && echo "  ${c_dim}sketchybar${c_rst} ↻ reloaded"
  fi
}

# Claude Code: ~/.claude/themes/omarchy.json + settings theme "custom:omarchy"
# (what omarchy-theme-set-claude --activate does). New sessions pick it up.
apply_claude() {
  local name="$1" src="$CACHE/$1/claude.json"
  [[ -f "$src" && -d "$CLAUDE_DIR" ]] || return 0
  mkdir -p "$CLAUDE_DIR/themes"
  cp "$src" "$CLAUDE_DIR/themes/omarchy.json"
  SETTINGS="$CLAUDE_DIR/settings.json" python3 - <<'PY'
import json, os
p = os.environ["SETTINGS"]
d = json.load(open(p)) if os.path.exists(p) else {}
if d.get("theme") != "custom:omarchy":
    d["theme"] = "custom:omarchy"
    json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")
PY
  echo "  ${c_dim}claude${c_rst}   → custom:omarchy ${c_dim}(new sessions)${c_rst}"
}

# Obsidian: an "Omarchy" theme in every vault Obsidian knows about, selected
# in appearance.json. Obsidian reloads the css of the active theme live.
apply_obsidian() {
  local name="$1" src="$CACHE/$1/obsidian.css"
  [[ -f "$src" && -f "$OBSIDIAN_JSON" ]] || return 0
  local count
  count="$(SRC="$src" OBS="$OBSIDIAN_JSON" python3 - <<'PY'
import json, os, shutil
vaults = json.load(open(os.environ["OBS"])).get("vaults", {}).values()
n = 0
for v in vaults:
    root = os.path.join(v["path"], ".obsidian")
    if not os.path.isdir(root): continue
    tdir = os.path.join(root, "themes", "Omarchy"); os.makedirs(tdir, exist_ok=True)
    man = os.path.join(tdir, "manifest.json")
    if not os.path.exists(man):
        json.dump({"name": "Omarchy", "version": "1.0.0", "minAppVersion": "0.16.0",
                   "description": "Follows the desktop theme (theme switcher)", "author": "Omarchy",
                   "authorUrl": "https://omarchy.org"}, open(man, "w"), indent=2)
    shutil.copy(os.environ["SRC"], os.path.join(tdir, "theme.css"))
    ap = os.path.join(root, "appearance.json")
    a = json.load(open(ap)) if os.path.exists(ap) else {}
    if a.get("cssTheme") != "Omarchy":
        a["cssTheme"] = "Omarchy"; json.dump(a, open(ap, "w"), indent=2)
    n += 1
print(n)
PY
)"
  echo "  ${c_dim}obsidian${c_rst} → Omarchy theme in $count vault(s)"
}

apply_wallpaper() {
  local name="$1" dir="$HOME/Pictures/Wallpapers"
  [[ -d "$dir" ]] || return 0
  shopt -s nullglob nocaseglob
  local files=( "$dir/${name}_"*.{jpg,jpeg,png,heic,webp} )
  shopt -u nocaseglob
  [[ ${#files[@]} -eq 0 ]] && { echo "  ${c_yel}wallpaper${c_rst} ! none found for '$name' in $dir — skipped"; return 0; }

  # If current desktop picture is already from this theme, keep it
  local current; current="$(osascript -e 'tell application "System Events" to tell current desktop to get picture' 2>/dev/null)"
  if [[ -n "$current" && "$(basename "$current")" == "${name}_"* ]]; then
    echo "  ${c_dim}wallpaper${c_rst} kept $(basename "$current")"
    return 0
  fi

  local pick="${files[$((RANDOM % ${#files[@]}))]}"
  osascript -e "tell application \"System Events\" to set picture of every desktop to \"$pick\"" >/dev/null 2>&1
  # keep the cycler's index in step so ⌘⌃P starts from this picture
  local idx=0 i=0
  for f in "${files[@]}"; do [[ "$f" == "$pick" ]] && idx=$i; i=$((i+1)); done
  mkdir -p "$HOME/.cache"; echo "$idx" > "$HOME/.cache/omarchy-wallpaper-index"
  echo "  ${c_dim}wallpaper${c_rst} → $(basename "$pick")"
}

# --- arg parsing ------------------------------------------------------------
do_reload=1; want_appearance=0; args=()
for a in "$@"; do
  case "$a" in
    -s|--sync)   sync_themes; exit 0 ;;
    -l|--list)   list_themes; exit 0 ;;
    --mode)      system_appearance; exit 0 ;;
    --appearance) want_appearance=1 ;;
    --no-reload) do_reload=0 ;;
    -h|--help)   sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)          die "unknown option: $a" ;;
    *)           args+=("$a") ;;
  esac
done

if [[ "$want_appearance" -eq 1 ]]; then
  t="${args[0]:-$(current_theme)}"
  [[ -d "$CACHE/$t" ]] || die "unknown theme: $t"
  theme_appearance "$t"; exit 0
fi

if [[ "${#args[@]}" -eq 0 ]]; then
  echo "${c_bold}current:${c_rst} $(current_theme)"; echo
  list_themes
  exit 0
fi

# auto-sync on first ever use
if [[ -z "$(installed_themes)" ]]; then
  echo "${c_dim}no themes cached yet — syncing first…${c_rst}"; sync_themes; echo
fi

name="${args[0]}"
if [[ "$name" == "random" && ! -d "$CACHE/random" ]]; then
  # `theme random [light|dark]` — mode arg wins, else detect once
  want="${args[1]:-$(system_appearance)}"
  name="$(pick_random_theme "$want")"
  echo "${c_dim}random pick ($want mode):${c_rst} ${c_bold}$name${c_rst}"
fi
if [[ ! -d "$CACHE/$name" ]]; then
  echo "${c_red}unknown theme:${c_rst} $name" >&2; echo >&2; list_themes >&2; exit 1
fi

echo "${c_bold}Switching to ${c_grn}$name${c_rst}${c_bold}:${c_rst}"
apply_ghostty "$name"
apply_nvim "$name"
apply_btop "$name"
apply_sketchybar "$name"
apply_claude "$name"
apply_obsidian "$name"
apply_wallpaper "$name"
mkdir -p "$(dirname "$STATE")"; echo "$name" > "$STATE"

if [[ "$do_reload" -eq 1 ]]; then
  reload_ghostty
  reload_nvim "$(colorscheme_of "$CACHE/$name/neovim.lua")"
  reload_btop
  reload_sketchybar
fi
echo "${c_grn}done.${c_rst} ${c_dim}New Ghostty windows + nvim sessions + btop launches use $name immediately.${c_rst}"
