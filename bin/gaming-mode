#!/bin/bash
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

osascript <<'EOF'
set keepList to {"com.apple.finder", "com.valvesoftware.steam"}
tell application "System Events"
	set bids to bundle identifier of every application process whose background only is false
end tell
repeat with bid in bids
	set b to contents of bid
	if b is not in keepList then
		try
			tell application id b to quit
		end try
	end if
end repeat
EOF

command -v tailscale >/dev/null 2>&1 && tailscale down

sketchybar --bar hidden=on

open -a Steam

echo "Gaming mode|||All apps quit, Tailscale down, bar hidden — Steam is up."
