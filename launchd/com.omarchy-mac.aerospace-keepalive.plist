<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omarchy-mac.aerospace-keepalive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/usr/bin/defaults write bobko.aerospace "NSStatusItem VisibleCC Item-0" -bool true; exec /Applications/AeroSpace.app/Contents/MacOS/AeroSpace</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/YOU/Library/Logs/aerospace-keepalive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/aerospace-keepalive.log</string>
</dict>
</plist>
