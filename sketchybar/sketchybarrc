#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

case "$(cat "$HOME/.config/omarchy/window-transparency" 2>/dev/null)" in
  opaque) BAR_COLOR="$BG" ;;
  glassy) BAR_COLOR="0x59${BG#0xff}" ;;
  *)      BAR_COLOR="$BG_TRANS" ;;
esac
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=30 \
  color="$BAR_COLOR" \
  border_width=0 \
  padding_left=8 \
  padding_right=8 \
  margin=0 \
  notch_width=200 \
  display=all \
  topmost=on

default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Bold:13.0"
  icon.color="$FG"
  label.color="$FG"
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=4
  label.padding_right=6
  background.corner_radius=6
  background.height=22
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change

sketchybar --add item logo left \
           --set logo \
                 icon="󰣇" \
                 icon.color="$ACCENT" \
                 icon.padding_left=8 \
                 icon.padding_right=8 \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="/opt/homebrew/bin/hs -c 'omarchyMenu()'"

for sid in 1 2 3 4 5; do
  sketchybar --add item space."$sid" left \
             --subscribe space."$sid" aerospace_workspace_change mouse.scrolled \
             --set space."$sid" \
                   icon="$sid" \
                   label.drawing=off \
                   background.color="$SURFACE" \
                   background.drawing=off \
                   click_script="/opt/homebrew/bin/aerospace workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh"
done

sketchybar --add item space_sep left \
           --set space_sep \
                 icon="" \
                 icon.color="$COMMENT" \
                 icon.padding_left=8 \
                 icon.padding_right=8 \
                 label.drawing=off \
                 background.drawing=off

sketchybar --add item front_app left \
           --set front_app \
                 label.color="$BLUE" \
                 label.max_chars=20 \
                 scroll_texts=on \
                 icon.padding_right=4 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --add event spotify_change "com.spotify.client.PlaybackStateChanged"
sketchybar --add event media_refresh
MEDIA_CONTROL="$(command -v media-control || echo /opt/homebrew/bin/media-control)"
sketchybar --add item media left \
           --set media \
                 drawing=off \
                 icon="󰐊" \
                 icon.color="$FG" \
                 label.color="$FG" \
                 label.max_chars=23 \
                 scroll_texts=on \
                 label.scroll_duration=200 \
                 background.drawing=off \
                 update_freq=2 \
                 script="$PLUGIN_DIR/media.sh" \
                 click_script="$MEDIA_CONTROL toggle-play-pause; sleep 0.3; sketchybar --trigger media_refresh" \
           --subscribe media spotify_change media_refresh

sketchybar --add item media_next left \
           --set media_next \
                 drawing=off \
                 icon="󰒭" \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="$MEDIA_CONTROL next-track; sleep 0.3; sketchybar --trigger media_refresh"

for ind in indicator_awake indicator_dnd; do
  sketchybar --add item "$ind" center \
             --set "$ind" \
                   drawing=off \
                   label.drawing=off \
                   background.drawing=off \
                   update_freq=10 \
                   script="$PLUGIN_DIR/indicators.sh"
done
sketchybar --subscribe indicator_awake system_woke display_change \
           --subscribe indicator_dnd display_change

sketchybar --add item clock center \
           --set clock \
                 update_freq=10 \
                 icon="" \
                 icon.color="$MAGENTA" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock display_change mouse.clicked

sketchybar --add item weather center \
           --set weather \
                 drawing=off \
                 icon.drawing=off \
                 label.color="$FG" \
                 update_freq=1800 \
                 script="$PLUGIN_DIR/weather.sh" \
                 click_script='open https://wttr.in' \
           --subscribe weather system_woke display_change

sketchybar --add event brew_upgraded
sketchybar --add item updates center \
           --set updates \
                 drawing=off \
                 update_freq=21600 \
                 script="$PLUGIN_DIR/updates.sh" \
                 click_script="open -na Ghostty --args -e $HOME/.local/bin/omarchy-tui sh -c 'brew update && brew upgrade; /opt/homebrew/bin/sketchybar --trigger brew_upgraded'" \
           --subscribe updates system_woke display_change brew_upgraded

sketchybar --add item theme_name center \
           --set theme_name \
                 icon="󰏘" \
                 icon.color="$YELLOW" \
                 label="$(cat "$HOME/.config/theme-switcher/current" 2>/dev/null || echo "?")" \
                 label.color="$FG" \
                 click_script="$HOME/.local/bin/theme random"

sketchybar --add item standup_center center \
           --set standup_center \
                 drawing=off \
                 update_freq=20 \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

sketchybar --add item sunset_center center \
           --set sunset_center \
                 drawing=off \
                 update_freq=60 \
                 background.drawing=off \
                 script="$PLUGIN_DIR/sunset.sh" \
           --subscribe sunset_center system_woke display_change

sketchybar --add item battery right \
           --set battery \
                 update_freq=120 \
                 icon.color="$GREEN" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/battery.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
           --subscribe battery system_woke power_source_change

sketchybar --add item standup right \
           --set standup \
                 drawing=off \
                 update_freq=20 \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

sketchybar --add item sunset right \
           --set sunset \
                 drawing=off \
                 update_freq=60 \
                 background.drawing=off \
                 script="$PLUGIN_DIR/sunset.sh" \
           --subscribe sunset system_woke display_change

sketchybar --add item clock_right right \
           --set clock_right \
                 drawing=off \
                 icon="󰥔" \
                 icon.color="$MAGENTA" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock_right mouse.clicked

sketchybar --add item volume right \
           --set volume \
                 update_freq=5 \
                 icon.color="$CYAN" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/volume.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"' \
           --subscribe volume volume_change

sketchybar --add item wifi right \
           --set wifi \
                 update_freq=30 \
                 script="$PLUGIN_DIR/wifi.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.wifi-settings-extension"'

sketchybar --add item bluetooth right \
           --set bluetooth \
                 update_freq=60 \
                 script="$PLUGIN_DIR/bluetooth.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.BluetoothSettings"' \
           --subscribe bluetooth display_change

for provider in grok codex claude; do
  icon="$(printf '%s' "${provider:0:1}" | tr a-z A-Z)${provider:1}"
  sketchybar --add item "agents_notch.$provider" right \
             --set "agents_notch.$provider" \
                   drawing=off \
                   icon="$icon" \
             --add item "agents.$provider" right \
             --set "agents.$provider" \
                   drawing=off \
                   icon="$icon" \
                   update_freq=300 \
                   script="$PLUGIN_DIR/agents.sh" \
             --subscribe "agents.$provider" display_change
done
for item in agents.claude agents_notch.claude; do
  sketchybar --set "$item" \
                   click_script="open -na Ghostty --args -e $HOME/.local/bin/omarchy-tui bunx ccusage daily"
done

sketchybar --add item bar_removed left --set bar_removed drawing=off popup.drawing=off
if [ -f "$HOME/.config/omarchy/bar-removed" ]; then
  while read -r removed; do
    [ -n "$removed" ] && sketchybar --set "$removed" position=popup.bar_removed
  done < "$HOME/.config/omarchy/bar-removed"
fi

sketchybar --update
sketchybar --trigger aerospace_workspace_change \
  FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused 2>/dev/null)"

NAME=volume bash "$PLUGIN_DIR/volume.sh"

FRONT_APP="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)"
NAME=front_app SENDER=front_app_switched INFO="$FRONT_APP" bash "$PLUGIN_DIR/front_app.sh"

NAME=media bash "$PLUGIN_DIR/media.sh"

NAME=standup bash "$PLUGIN_DIR/standup.sh"
NAME=standup_center bash "$PLUGIN_DIR/standup.sh"

sketchybar --update
