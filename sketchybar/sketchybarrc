#!/usr/bin/env bash
# SketchyBar — Tokyo Night, AeroSpace-aware
# Reload: brew services restart sketchybar  (or: sketchybar --reload)

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# ---------- Bar ----------
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=30 \
  color="$BG_TRANS" \
  border_width=0 \
  padding_left=8 \
  padding_right=8 \
  margin=0 \
  notch_width=200 \
  display=all \
  topmost=window

# ---------- Defaults ----------
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Bold:13.0"
  icon.color="$FG"
  label.color="$FG"
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=4
  label.padding_right=6
  background.corner_radius=6
  background.height=22
)
sketchybar --default "${default[@]}"

# ---------- Custom events ----------
sketchybar --add event aerospace_workspace_change

# ---------- Logo: opens the Omarchy menu (v4 bar, leftmost) ----------
sketchybar --add item logo left \
           --set logo \
                 icon="󰣇" \
                 icon.color="$ACCENT" \
                 icon.padding_left=8 \
                 icon.padding_right=8 \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="/opt/homebrew/bin/hs -c 'omarchyMenu()'"

# ---------- AeroSpace workspaces ----------
for sid in 1 2 3 4 5; do
  sketchybar --add item space."$sid" left \
             --subscribe space."$sid" aerospace_workspace_change \
             --set space."$sid" \
                   icon="$sid" \
                   label.drawing=off \
                   background.color="$SURFACE" \
                   background.drawing=off \
                   click_script="/opt/homebrew/bin/aerospace workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh"
done

# Separator between workspaces and front_app
sketchybar --add item space_sep left \
           --set space_sep \
                 icon="" \
                 icon.color="$COMMENT" \
                 icon.padding_left=8 \
                 icon.padding_right=8 \
                 label.drawing=off \
                 background.drawing=off

# ---------- Front app (focused window) ----------
sketchybar --add item front_app left \
           --set front_app \
                 label.color="$BLUE" \
                 icon.padding_right=4 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# ---------- Music (now playing, any player) ----------
# Whatever plays (Spotify, YouTube Music in Brave, any player), from macOS
# Now Playing via media-control, like Omarchy 4's media widget (MPRIS).
# Spotify's notification refreshes it at once; update_freq covers the rest.
# Title: 23 characters (about 180 px in Hack Nerd Font 13), the width of
# Omarchy 4's media widget (maxLabelWidth: 180). Longer titles scroll.
sketchybar --add event spotify_change "com.spotify.client.PlaybackStateChanged"
sketchybar --add event media_refresh
# Full path: click scripts do not get Homebrew on PATH.
MEDIA_CONTROL="$(command -v media-control || echo /opt/homebrew/bin/media-control)"
sketchybar --add item media left \
           --set media \
                 drawing=off \
                 icon="󰐊" \
                 icon.color="$FG" \
                 label.color="$FG" \
                 label.max_chars=23 \
                 scroll_texts=on \
                 label.scroll_duration=200 \
                 background.drawing=off \
                 update_freq=2 \
                 script="$PLUGIN_DIR/media.sh" \
                 click_script="$MEDIA_CONTROL toggle-play-pause; sleep 0.3; sketchybar --trigger media_refresh" \
           --subscribe media spotify_change media_refresh

# Next-track button (shown/hidden together with the title by media.sh)
sketchybar --add item media_next left \
           --set media_next \
                 drawing=off \
                 icon="󰒭" \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="$MEDIA_CONTROL next-track; sleep 0.3; sketchybar --trigger media_refresh"

# ---------- Center: indicators · clock · weather · updates · theme ----------
# Indicators show only while their state is on (v4 bar). Pinned to the
# external displays by clock.sh, like the clock: the notch eats the centre.
for ind in indicator_awake indicator_dnd; do
  sketchybar --add item "$ind" center \
             --set "$ind" \
                   drawing=off \
                   label.drawing=off \
                   background.drawing=off \
                   update_freq=10 \
                   script="$PLUGIN_DIR/indicators.sh"
done
sketchybar --subscribe indicator_awake system_woke display_change \
           --subscribe indicator_dnd display_change

sketchybar --add item clock center \
           --set clock \
                 update_freq=10 \
                 icon="" \
                 icon.color="$MAGENTA" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/clock.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Date-Time-Settings.extension"' \
           --subscribe clock display_change

sketchybar --add item weather center \
           --set weather \
                 drawing=off \
                 icon.drawing=off \
                 label.color="$FG" \
                 update_freq=1800 \
                 script="$PLUGIN_DIR/weather.sh" \
                 click_script='open https://wttr.in' \
           --subscribe weather system_woke display_change

# Update badge: outdated Homebrew packages, hidden at zero (v4 bar).
# The click runs the upgrade, then fires brew_upgraded so the badge recounts at once.
sketchybar --add event brew_upgraded
sketchybar --add item updates center \
           --set updates \
                 drawing=off \
                 update_freq=21600 \
                 script="$PLUGIN_DIR/updates.sh" \
                 click_script="open -na Ghostty --args -e $HOME/.local/bin/omarchy-tui sh -c 'brew update && brew upgrade; /opt/homebrew/bin/sketchybar --trigger brew_upgraded'" \
           --subscribe updates system_woke display_change brew_upgraded

# Current theme name — label re-reads on every `sketchybar --reload`, which the
# `theme` script fires after each switch. Click = shuffle (theme random).
sketchybar --add item theme_name center \
           --set theme_name \
                 icon="󰏘" \
                 icon.color="$YELLOW" \
                 label="$(cat "$HOME/.config/theme-switcher/current" 2>/dev/null || echo "?")" \
                 label.color="$FG" \
                 click_script="$HOME/.local/bin/theme random"

# Stand-up / sit-down state, centre copy: shows on the external displays next to
# the centred theme name. Added straight after theme_name so it lands beside it.
# The right-cluster copy (standup) covers the built-in panel. One plugin drives
# both; it pins each copy to the right display set like clock.sh does.
sketchybar --add item standup_center center \
           --set standup_center \
                 drawing=off \
                 update_freq=20 \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

# v4 bar order, left to right: agents · bluetooth · network · audio · power.
# Right items lay out right-to-left in add order, so battery goes first.
sketchybar --add item battery right \
           --set battery \
                 update_freq=120 \
                 icon.color="$GREEN" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/battery.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
           --subscribe battery system_woke power_source_change

# Right-side clock + theme name — the leftmost pair of the right cluster, i.e.
# immediately in front of the battery. These are the built-in display's variant:
# clock.sh pins them to the notched laptop panel and pins the centered pair to
# the external displays, so both layouts are live at once on different screens.
#
# Right-side items are laid out right-to-left in the order they're added, so
# theme_name_right must be added BEFORE clock_right to end up on its right —
# preserving the same clock-then-theme reading order as the centered pair.
sketchybar --add item theme_name_right right \
           --set theme_name_right \
                 drawing=off \
                 icon="󰏘" \
                 icon.color="$YELLOW" \
                 label.color="$FG" \
                 click_script="$HOME/.local/bin/theme random"

# Stand-up / sit-down state of the interval timer (~/.hermes/standup_timer.sh).
# Added straight after theme_name_right so it draws immediately to the LEFT of the
# theme name (right items lay out right-to-left in add order). Icon only: a chair
# while seated, a standing person while standing. Hidden when no timer runs.
sketchybar --add item standup right \
           --set standup \
                 drawing=off \
                 update_freq=20 \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

sketchybar --add item clock_right right \
           --set clock_right \
                 drawing=off \
                 icon="󰥔" \
                 icon.color="$MAGENTA" \
                 label.color="$FG" \
                 click_script='open "x-apple.systempreferences:com.apple.Date-Time-Settings.extension"'


sketchybar --add item volume right \
           --set volume \
                 update_freq=5 \
                 icon.color="$CYAN" \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/volume.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"' \
           --subscribe volume volume_change

sketchybar --add item wifi right \
           --set wifi \
                 update_freq=30 \
                 script="$PLUGIN_DIR/wifi.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.wifi-settings-extension"'

sketchybar --add item bluetooth right \
           --set bluetooth \
                 update_freq=60 \
                 script="$PLUGIN_DIR/bluetooth.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.BluetoothSettings"'

# Coding-agent usage: Claude Code 5-hour and weekly limits (v4.0.5 agents
# widget), or today's spend when the limits are unknown. The script checks
# every 5 minutes, so an ended window drops to 0% soon; Anthropic is asked at
# most every 15 minutes (omarchy-agent-usage-claude caches the answer).
sketchybar --add item agents right \
           --set agents \
                 drawing=off \
                 update_freq=300 \
                 script="$PLUGIN_DIR/agents.sh" \
                 click_script="open -na Ghostty --args -e $HOME/.local/bin/omarchy-tui bunx ccusage daily"

# ---------- Force first run ----------
sketchybar --update
sketchybar --trigger aerospace_workspace_change \
  FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused 2>/dev/null)"

# Volume only subscribes to volume_change events, so prime it on startup
NAME=volume bash "$PLUGIN_DIR/volume.sh"

# Prime front_app on startup with the currently focused app name
FRONT_APP="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)"
NAME=front_app SENDER=front_app_switched INFO="$FRONT_APP" bash "$PLUGIN_DIR/front_app.sh"

# Prime the music item on startup
NAME=media bash "$PLUGIN_DIR/media.sh"

# Prime the stand-up / sit-down icons on startup (they have no event to subscribe to)
NAME=standup bash "$PLUGIN_DIR/standup.sh"
NAME=standup_center bash "$PLUGIN_DIR/standup.sh"

# Run every item script once now: after a reload, an item is blank until its first
# update_freq tick (weather 30 min, updates 6 h), which hid the clock after a theme switch.
sketchybar --update
